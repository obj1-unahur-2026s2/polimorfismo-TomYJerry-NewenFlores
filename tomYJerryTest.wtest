import tomYJerry.*

describe "tests de tom y jerry" {
    test "1. Al inicio, la velocidad máxima de Tom es 10 (su energía es 50)"{
    assert.equals(10, tom.velocidadMaxima())
    }

 test "2. Si come a Jerry, la velocidad máxima pasa a ser 15.2 (su energía es 102)"{
        tom.comer(jerry)
        assert.equals(15.2, tom.velocidadMaxima())
    }

 test "3. Si corre 24 metros, entonces su velocidad máxima pasa a ser 14 (su energía es 90)"{
        tom.correr(24)
       assert.equals(14, tom.velocidadMaxima())
    }

 test "4. Si come a Nibbles, pasa a tener de velocidad máxima 18.7 (su energía es 137)"{
        tom.comer(nibbles)
        assert.equals(18.7, tom.velocidadMaxima())
    }

 test "5. si Jerry cumple años (3 años de edad), y luego Tom lo vuelve a comer, pasaría a tener 25.9 (su energia es 209)"{
        jerry.cumplirAnios()
        assert.equals(25.9, tom.velocidadMaxima())
    }

 test "6. si corre 38 metros su velocidad pasa a ser 24 (su energia es 190)"{
        tom.correr(38)
        assert.equals(24, tom.velocidadMaxima())
    }

}